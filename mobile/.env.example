# Copy to .env and fill in. Firebase console > Project settings > Your apps > Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Razorpay Dashboard (Test mode) > Account & Settings > API Keys. Key ID only, never the secret.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Your deployed admin panel, e.g. https://pureflow-admin.vercel.app (used for /api/notify).
EXPO_PUBLIC_API_BASE=

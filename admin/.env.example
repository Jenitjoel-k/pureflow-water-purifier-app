# ---- Client (browser) – Firebase web app config. Set these in Vercel too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Server only (Vercel function api/notify.js). Never prefix these with VITE_.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line (or base64 of it).
FIREBASE_SERVICE_ACCOUNT=

# TextBee SMS (https://textbee.dev) – optional
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# EmailJS (https://www.emailjs.com) – optional. Enable "Allow EmailJS API for non-browser applications".
# Template variables used: {{to_email}} {{to_name}} {{title}} {{message}}
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
